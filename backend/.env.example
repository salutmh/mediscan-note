# backend 환경변수 — 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 커밋 금지)

# DB. 미설정이면 backend/mediscan.db (SQLite) 를 자동 생성한다.
# PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/mediscan
DATABASE_URL=

# 액세스 토큰 서명 키. 배포 전 반드시 설정할 것.
# 미설정 시 개발용 고정값으로 기동되며 경고가 출력된다 (app/security.py).
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDISCAN_SECRET_KEY=

# 토큰 수명(초). 기본 604800 (7일)
MEDISCAN_TOKEN_TTL=604800

# 케이스 영상·마스크 URL 에 붙는 공개 base. **배포 시에만 설정한다.**
# 비워 두면 요청이 들어온 주소를 그대로 쓰므로 로컬에서는 포트를 바꿔도 알아서 맞는다.
MEDISCAN_PUBLIC_BASE=

# 화면 5(업로드 분석) 예시 응답을 켠다. 기본 OFF — 개발 확인용으로만 사용.
MEDISCAN_ANALYZE_DEMO=

# 학습 리포 경로 (오프라인 예측 계산에만 필요. 서비스 런타임은 쓰지 않는다)
MEDISCAN_VS_SEG_ROOT=
