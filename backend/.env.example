# backend 환경변수 — 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 커밋 금지)
#
# 실제 secret 값을 이 파일에 적지 않는다. 여기에는 변수명과 설명만 둔다.

# 실행 환경: development(기본) | production
# production 으로 두면 아래 필수 값이 없을 때 **기동이 실패한다** (조용히 뜨지 않는다).
MEDISCAN_ENV=development

# DB. **production 필수** — 미설정이면 기동이 실패한다.
#   development — 미설정 시 backend/mediscan.db (SQLite) 자동 생성
#   production  — 미설정 시 컨테이너 안 로컬 SQLite 로 떨어져 재배포마다 데이터가 사라지므로 차단
# PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/mediscan
# 의도적으로 SQLite 를 쓰려면 볼륨 경로를 직접: sqlite:////data/mediscan.db
DATABASE_URL=

# 액세스 토큰 서명 키. **production 필수** (32자 이상).
#   development — 미설정 시 개발용 고정값 + 경고
#   production  — 미설정이거나 개발용 고정값이면 기동 실패 (그 값은 공개 저장소에 있다)
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDISCAN_SECRET_KEY=

# 허용할 프론트 오리진(쉼표 구분). **production 필수**, 와일드카드(*) 금지.
#   development — 미설정 시 localhost/127.0.0.1 의 아무 포트를 허용한다
#   예: MEDISCAN_CORS_ORIGINS=https://mediscan.example.com,https://www.example.com
MEDISCAN_CORS_ORIGINS=

# 로깅. 설정하지 않으면 앱의 INFO 로그가 전부 버려진다 (root 기본 레벨이 WARNING).
#   MEDISCAN_LOG_LEVEL   DEBUG | INFO(기본) | WARNING | ERROR
#   MEDISCAN_LOG_FORMAT  text(기본) | json  — json 은 로그 수집기에 넣기 좋다
MEDISCAN_LOG_LEVEL=
MEDISCAN_LOG_FORMAT=

# 인증 엔드포인트 요청 수 제한. 기본 ON. 끄려면 0 (개발/테스트용).
MEDISCAN_RATE_LIMIT=
# 한도 배수 (부하 테스트 등에서 임시로 넉넉히 줄 때만)
MEDISCAN_RATE_LIMIT_MULTIPLIER=

# 토큰 수명(초). 기본 604800 (7일)
MEDISCAN_TOKEN_TTL=604800

# 케이스 영상·마스크 URL 에 붙는 공개 base. **배포 시에만 설정한다.**
# 비워 두면 요청이 들어온 주소를 그대로 쓰므로 로컬에서는 포트를 바꿔도 알아서 맞는다.
MEDISCAN_PUBLIC_BASE=

# 화면 5(업로드 분석) 예시 응답을 켠다. 기본 OFF — 개발 확인용으로만 사용.
MEDISCAN_ANALYZE_DEMO=

# 학습 리포 경로 (오프라인 예측 계산에만 필요. 서비스 런타임은 쓰지 않는다)
MEDISCAN_VS_SEG_ROOT=
