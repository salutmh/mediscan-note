# 복사해서 .env 로 저장한 뒤 값을 수정하세요. (.env 는 git에 올라가지 않습니다)

# 모델 가중치 경로 (상대경로는 프로젝트 루트 기준)
MODEL_PATH=./weights/best.pt

# 서버 바인딩
HOST=0.0.0.0
PORT=8000

# 뷰어(프론트엔드)에서 호출을 허용할 origin 목록 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 검출 최소 confidence (0~1)
CONF_THRESHOLD=0.25

# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=20
